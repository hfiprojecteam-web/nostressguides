var _activeItinId = null, _globalStops = [];

function buildGlobalStops(it) {
  var res=[], n=1;
  it.dl.forEach(function(day,di){
    var prev=null;
    day.stops.forEach(function(s){
      var d=getDestById(s.loc);
      var xy=d?[d.lat,d.lng]:null;
      if(!xy)return;
      if(s.loc===prev){if(res.length>0&&res[res.length-1].dayIdx===di)res[res.length-1].label+=' + '+s.n;return;}
      prev=s.loc;
      res.push({locId:s.loc,coords:xy,label:s.n,num:n++,dayIdx:di});
    });
  });
  return res;
}

function activateItinerary(it){_activeItinId=it.id;_globalStops=buildGlobalStops(it);}

function mkIcon(type) {
  var conf={hub:{col:'#1a3a5c'},coastal:{col:'#2d6a4f'},historic:{col:'#8a5a10'},daytripicon:{col:'#6a2a2a'}};
  var c=(conf[type]||conf.hub).col;
  var letter={'hub':'H','coastal':'C','historic':'H','daytripicon':'D'}[type]||'H';
  return L.divIcon({html:'<div style="width:30px;height:30px;border-radius:50%;background:'+c+';border:2.5px solid white;box-shadow:0 2px 8px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;color:white;font-size:11px;font-weight:700;">'+letter+'</div>',iconSize:[30,30],iconAnchor:[15,15],popupAnchor:[0,-18],className:''});
}

function getDestById(id){for(var i=0;i<DESTS.length;i++)if(DESTS[i].id===id)return DESTS[i];return null;}

window.onload = function(){
  nsMap=L.map('map',{zoomControl:true}).setView([46.5,2.5],6);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',{attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:19}).addTo(nsMap);
  markersLayer=L.layerGroup().addTo(nsMap);
  placeLandmarkMarkers();
  buildItinList();
  fillSelects();
  fillBldSelect(document.querySelector('.bld-sel[data-index="0"]'));
  document.querySelector('.bld-rm[data-index="0"]').addEventListener('click',function(){removeBldStop(0);});
  setupBldDrag();updateBldState();
  document.getElementById('bldAdd').addEventListener('click',addBldStop);
  document.getElementById('bldCalc').addEventListener('click',calcBldRoute);
  document.getElementById('bldClear').addEventListener('click',clearBld);
  document.getElementById('px').addEventListener('click',function(){document.getElementById('panel').classList.remove('open');});
  document.getElementById('fab').addEventListener('click',function(){document.getElementById('panel').classList.toggle('open');});
};

function placeLandmarkMarkers(){
  markersLayer.clearLayers();
  DESTS.forEach(function(d){
    var html='<div class="pu"><div class="pu-name">'+d.n+'</div><div class="pu-type">'+d.tag+'</div><div class="pu-row"><b>Best time:</b> '+d.best+'</div><div class="pu-row"><b>Stay:</b> '+d.days+'</div><div class="pu-tip">'+d.tip+'</div></div>';
    L.marker([d.lat,d.lng],{icon:mkIcon(d.type)}).bindPopup(html,{maxWidth:260}).addTo(markersLayer);
  });
}

function buildItinList(){
  var cont=document.getElementById('itinList');
  ITINS.forEach(function(it){
    var card=document.createElement('div');
    card.className='itin-card';
    var btns=it.dl.map(function(d,i){return '<button class="dbtn'+(i===0?' on':'')+'" data-itin="'+it.id+'" data-idx="'+i+'">'+d.lbl+'</button>';}).join('');
    card.innerHTML='<h3>'+it.n+'</h3><div class="imeta">'+it.days+'&nbsp;&nbsp;'+it.transport+'</div><div class="idesc">'+it.desc+'</div><div class="dtabs" id="dtabs-'+it.id+'">'+btns+'</div>';
    card.addEventListener('click',function(e){
      if(e.target.closest&&e.target.closest('.dbtn'))return;
      var isOn=card.classList.contains('on');
      document.querySelectorAll('.itin-card').forEach(function(c){c.classList.remove('on');});
      document.querySelectorAll('.dtabs').forEach(function(t){t.classList.remove('on');});
      clearRoutes();
      if(!isOn){
        card.classList.add('on');
        document.getElementById('dtabs-'+it.id).classList.add('on');
        activateItinerary(it);
        drawDay(it,0);
        document.querySelectorAll('#dtabs-'+it.id+' .dbtn').forEach(function(b,i){b.classList.toggle('on',i===0);});
      }
    });
    cont.appendChild(card);
  });
  cont.addEventListener('click',function(e){
    var btn=e.target.closest('[data-itin]');
    if(!btn)return;
    e.stopPropagation();
    var itId=btn.getAttribute('data-itin'),idx=parseInt(btn.getAttribute('data-idx'));
    var it2=null;for(var i=0;i<ITINS.length;i++){if(ITINS[i].id===itId){it2=ITINS[i];break;}}
    if(!it2)return;
    if(_activeItinId!==itId)activateItinerary(it2);
    document.querySelectorAll('#dtabs-'+itId+' .dbtn').forEach(function(b){b.classList.remove('on');});
    btn.classList.add('on');
    drawDay(it2,idx);
  });
}

function clearRoutes(){
  activeRouteObjs.forEach(function(o){nsMap.removeLayer(o);});
  activeRouteObjs=[];
  document.getElementById('stops').classList.remove('on');
}

function drawDay(it,dayIdx){
  clearRoutes();
  var day=it.dl[dayIdx];
  if(!day)return;
  DESTS.forEach(function(d){activeRouteObjs.push(L.circleMarker([d.lat,d.lng],{radius:4,color:'#fff',fillColor:'#b0bccc',fillOpacity:.35,weight:1,interactive:false}).addTo(nsMap));});
  var dayStops=_globalStops.filter(function(s){return s.dayIdx===dayIdx;});
  var prevLast=null;
  if(dayIdx>0){var prev=_globalStops.filter(function(s){return s.dayIdx===dayIdx-1;});if(prev.length)prevLast=prev[prev.length-1];}
  if(prevLast&&dayStops.length>0&&prevLast.locId!==dayStops[0].locId){
    activeRouteObjs.push(L.polyline([prevLast.coords,dayStops[0].coords],{color:'#e8a838',weight:3,opacity:.75,dashArray:'8,5',lineCap:'round'}).addTo(nsMap));
    activeRouteObjs.push(L.marker(prevLast.coords,{icon:L.divIcon({className:'',html:'<div style="width:22px;height:22px;border-radius:50%;background:#99a8bb;border:2px solid white;box-shadow:0 1px 5px rgba(0,0,0,.2);display:flex;align-items:center;justify-content:center;color:white;font-size:10px;font-weight:600;">'+prevLast.num+'</div>',iconSize:[22,22],iconAnchor:[11,11],zIndexOffset:350}),zIndexOffset:350}).addTo(nsMap));
  }
  for(var j=0;j<dayStops.length-1;j++){
    if(dayStops[j].locId===dayStops[j+1].locId)continue;
    activeRouteObjs.push(L.polyline([dayStops[j].coords,dayStops[j+1].coords],{color:'#2d6a4f',weight:5,opacity:1,dashArray:'10,6',lineCap:'round',lineJoin:'round'}).addTo(nsMap));
  }
  var bCoords=[];
  dayStops.forEach(function(s){
    bCoords.push(s.coords);
    var lbl=s.label.length>24?s.label.substring(0,22)+'...':s.label;
    var icon=L.divIcon({className:'',html:'<div style="text-align:center;width:130px;"><div style="width:30px;height:30px;border-radius:50%;background:#c4533a;border:3px solid white;box-shadow:0 2px 10px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:700;margin:0 auto;">'+s.num+'</div><div style="margin-top:3px;font-size:10px;font-weight:700;color:#112244;background:rgba(255,255,255,.92);border-radius:3px;padding:1px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:130px;display:inline-block;">'+lbl+'</div></div>',iconSize:[130,46],iconAnchor:[65,15],zIndexOffset:700});
    activeRouteObjs.push(L.marker(s.coords,{icon:icon,zIndexOffset:700}).addTo(nsMap));
  });
  if(prevLast&&prevLast.locId!==dayStops[0].locId)bCoords.push(prevLast.coords);
  var seen={},uniq=[];
  bCoords.forEach(function(xy){var k=xy[0].toFixed(2)+','+xy[1].toFixed(2);if(!seen[k]){seen[k]=true;uniq.push(xy);}});
  if(uniq.length>1)nsMap.fitBounds(L.latLngBounds(uniq),{paddingTopLeft:[380,70],paddingBottomRight:[80,90],animate:true,maxZoom:10});
  else if(uniq.length===1)nsMap.setView(uniq[0],9,{animate:true});
  document.getElementById('stopsTitle').textContent=it.n+' — '+day.lbl;
  document.getElementById('stopsBd').innerHTML=day.stops.map(function(s,i){return '<div class="srow"><span class="snum">'+(i+1)+'</span><span class="sname">'+s.n+'</span>'+(s.time?'<span class="stime">'+s.time+'</span>':'')+(s.tip?'<div class="stip">'+s.tip+'</div>':'')+'</div>';}).join('');
  document.getElementById('stops').classList.add('on');
  if(window.innerWidth<=768)document.getElementById('panel').classList.remove('open');
}

function getRoute(from,to){return ROUTES[from+'-'+to]||ROUTES[to+'-'+from]||null;}

function fillSelects(){
  ['selFrom','selTo'].forEach(function(sid){
    var sel=document.getElementById(sid);
    if(!sel)return;
    DESTS.forEach(function(d){var opt=document.createElement('option');opt.value=d.id;opt.textContent=d.n;sel.appendChild(opt);});
    sel.addEventListener('change',liveRoute);
  });
}

function liveRoute(){
  var from=document.getElementById('selFrom').value;
  var to=document.getElementById('selTo').value;
  var res=document.getElementById('rtResult');
  if(!from||!to||from===to){res.classList.remove('on');clearRoutes();placeLandmarkMarkers();return;}
  var A=getDestById(from),B=getDestById(to);
  if(!A||!B)return;
  var r=getRoute(from,to);
  clearRoutes();placeLandmarkMarkers();
  var line=L.polyline([[A.lat,A.lng],[B.lat,B.lng]],{color:'#c4533a',weight:5,opacity:.95,dashArray:'9,6',lineCap:'round'}).addTo(nsMap);
  activeRouteObjs.push(line);
  [{d:A,lbl:'A'},{d:B,lbl:'B'}].forEach(function(pt){
    var icon=L.divIcon({className:'',html:'<div style="text-align:center;width:100px;"><div style="width:28px;height:28px;border-radius:50%;background:#c4533a;border:3px solid white;box-shadow:0 2px 10px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;color:white;font-size:11px;font-weight:700;margin:0 auto;">'+pt.lbl+'</div><div style="margin-top:3px;font-size:10px;font-weight:700;color:#112244;background:rgba(255,255,255,.9);border-radius:3px;padding:1px 4px;white-space:nowrap;max-width:100px;overflow:hidden;text-overflow:ellipsis;display:inline-block;">'+pt.d.n+'</div></div>',iconSize:[100,40],iconAnchor:[50,14],zIndexOffset:600});
    activeRouteObjs.push(L.marker([pt.d.lat,pt.d.lng],{icon:icon,zIndexOffset:600}).addTo(nsMap));
  });
  nsMap.fitBounds(L.latLngBounds([[A.lat,A.lng],[B.lat,B.lng]]),{paddingTopLeft:[380,60],paddingBottomRight:[80,60],animate:true,maxZoom:9});
  if(r){
    document.getElementById('rtMain').textContent=A.n+' \u2192 '+B.n+' \u2014 '+r.t;
    document.getElementById('rtDetail').textContent='Distance: '+r.d+' \u00b7 Mode: '+r.m;
    document.getElementById('rtTip').textContent=r.tip;
  } else {
    document.getElementById('rtMain').textContent=A.n+' \u2192 '+B.n;
    document.getElementById('rtDetail').textContent='Indicative straight line. Check SNCF Connect for exact connections.';
    document.getElementById('rtTip').textContent='Most French cities connect via TGV with at most 1 change. Book at sncf-connect.com for live schedules and prices.';
  }
  res.classList.add('on');
}

function fillBldSelect(sel){
  if(!sel)return;
  DESTS.forEach(function(d){var opt=document.createElement('option');opt.value=d.id;opt.textContent=d.n;sel.appendChild(opt);});
  sel.addEventListener('change',updateBldState);
}

function addBldStop(){
  var container=document.getElementById('bldStops');
  var idx=container.querySelectorAll('.bld-stop').length;
  var div=document.createElement('div');div.className='bld-stop';div.setAttribute('data-index',idx);
  div.innerHTML='<span class="bld-handle">&#9776;</span><span class="bld-num">'+(idx+1)+'</span><select class="bld-sel" data-index="'+idx+'"><option value="">Select destination...</option></select><button class="bld-rm" data-index="'+idx+'">&#215;</button>';
  container.appendChild(div);
  fillBldSelect(div.querySelector('.bld-sel'));
  div.querySelector('.bld-rm').addEventListener('click',function(){removeBldStop(parseInt(this.getAttribute('data-index')));});
  setupBldDrag();updateBldState();
}

function removeBldStop(idx){
  var container=document.getElementById('bldStops');
  if(container.querySelectorAll('.bld-stop').length<=1)return;
  var el=container.querySelector('.bld-stop[data-index="'+idx+'"]');
  if(el)el.remove();
  renumberBld();updateBldState();
}

function renumberBld(){
  document.querySelectorAll('.bld-stop').forEach(function(s,i){
    s.setAttribute('data-index',i);s.querySelector('.bld-num').textContent=i+1;
    var sel=s.querySelector('.bld-sel');if(sel)sel.setAttribute('data-index',i);
    var rm=s.querySelector('.bld-rm');if(rm)rm.setAttribute('data-index',i);
  });
}

function updateBldState(){
  var vals=Array.from(document.querySelectorAll('.bld-sel')).map(function(s){return s.value;}).filter(Boolean);
  document.getElementById('bldCalc').disabled=vals.length<2;
}

function setupBldDrag(){
  document.querySelectorAll('.bld-stop').forEach(function(s){
    s.setAttribute('draggable','true');
    s.ondragstart=function(e){this.classList.add('dragging');e.dataTransfer.setData('text/plain',this.getAttribute('data-index'));};
    s.ondragend=function(){this.classList.remove('dragging');document.querySelectorAll('.bld-stop').forEach(function(x){x.classList.remove('drag-over');});};
    s.ondragover=function(e){e.preventDefault();this.classList.add('drag-over');};
    s.ondragleave=function(){this.classList.remove('drag-over');};
    s.ondrop=function(e){
      e.preventDefault();this.classList.remove('drag-over');
      var fromIdx=parseInt(e.dataTransfer.getData('text/plain'));
      var toIdx=parseInt(this.getAttribute('data-index'));
      if(fromIdx===toIdx)return;
      var container=document.getElementById('bldStops');
      var all=Array.from(container.querySelectorAll('.bld-stop'));
      var moved=all.splice(fromIdx,1)[0];all.splice(toIdx,0,moved);
      all.forEach(function(x){container.appendChild(x);});
      renumberBld();updateBldState();
    };
  });
}

function clearBld(){
  var container=document.getElementById('bldStops');
  container.innerHTML='<div class="bld-stop" data-index="0"><span class="bld-handle">&#9776;</span><span class="bld-num">1</span><select class="bld-sel" data-index="0"><option value="">Add first stop...</option></select><button class="bld-rm" data-index="0">&#215;</button></div>';
  fillBldSelect(container.querySelector('.bld-sel'));
  container.querySelector('.bld-rm').addEventListener('click',function(){removeBldStop(0);});
  setupBldDrag();document.getElementById('bldResults').innerHTML='';document.getElementById('bldCalc').disabled=true;
  clearRoutes();placeLandmarkMarkers();
}

function calcBldRoute(){
  var stops=Array.from(document.querySelectorAll('.bld-sel')).map(function(s){return s.value;}).filter(Boolean);
  if(stops.length<2)return;
  clearRoutes();placeLandmarkMarkers();
  var legs=[],coords=[];
  for(var i=0;i<stops.length-1;i++){
    var A=getDestById(stops[i]),B=getDestById(stops[i+1]);
    if(!A||!B)continue;
    var r=getRoute(stops[i],stops[i+1]);
    legs.push({A:A,B:B,r:r});
    activeRouteObjs.push(L.polyline([[A.lat,A.lng],[B.lat,B.lng]],{color:'#c4533a',weight:4,opacity:.9,dashArray:'7,5',lineCap:'round'}).addTo(nsMap));
    coords.push([A.lat,A.lng]);
  }
  var last=getDestById(stops[stops.length-1]);if(last)coords.push([last.lat,last.lng]);
  stops.forEach(function(id,i){
    var d=getDestById(id);if(!d)return;
    var icon=L.divIcon({className:'',html:'<div style="text-align:center;width:110px;"><div style="width:30px;height:30px;border-radius:50%;background:#c4533a;border:3px solid white;box-shadow:0 2px 10px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:700;margin:0 auto;">'+(i+1)+'</div><div style="margin-top:3px;font-size:10px;font-weight:700;color:#112244;background:rgba(255,255,255,.9);border-radius:3px;padding:1px 4px;white-space:nowrap;max-width:110px;overflow:hidden;text-overflow:ellipsis;display:inline-block;">'+d.n+'</div></div>',iconSize:[120,38],iconAnchor:[60,11]});
    activeRouteObjs.push(L.marker([d.lat,d.lng],{icon:icon,zIndexOffset:500}).addTo(nsMap));
  });
  if(coords.length>1)nsMap.fitBounds(L.latLngBounds(coords),{padding:[80,80],animate:true});
  var html='';
  legs.forEach(function(leg){
    html+='<div class="bld-leg"><div class="bld-leg-head">'+leg.A.n+' &rarr; '+leg.B.n+(leg.r?' &mdash; '+leg.r.t:'')+'</div>';
    if(leg.r)html+='<div class="bld-leg-detail"><b>Distance:</b> '+leg.r.d+' &middot; <b>Mode:</b> '+leg.r.m+'</div><div class="bld-leg-tip">'+leg.r.tip+'</div>';
    else html+='<div class="bld-leg-detail">Check sncf-connect.com for connections.</div>';
    html+='</div>';
  });
  document.getElementById('bldResults').innerHTML=html;
}

function showPane(id,btn){
  clearRoutes();
  document.querySelectorAll('.itin-card').forEach(function(c){c.classList.remove('on');});
  document.querySelectorAll('.dtabs').forEach(function(t){t.classList.remove('on');});
  var rtr=document.getElementById('rtResult');if(rtr)rtr.classList.remove('on');
  document.querySelectorAll('.tbtn').forEach(function(b){b.classList.remove('on');});
  document.querySelectorAll('.pane').forEach(function(p){p.classList.remove('on');});
  btn.classList.add('on');document.getElementById('pane-'+id).classList.add('on');
  placeLandmarkMarkers();
}
</script>
</body>
</html>
