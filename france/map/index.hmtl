<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>France No-Stress -- Interactive Map</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
:root{--p:#112244;--r:#c4533a;--a:#e8a838;--l:#f5f1eb;--d:#2c2c2c;--g:#2d6a4f;--bd:#e0d8cc}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--l);color:var(--d);overflow:hidden}
.hdr{position:fixed;top:0;left:0;right:0;height:50px;background:var(--p);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 16px;z-index:1001;box-shadow:0 2px 12px rgba(0,0,0,.15)}
.hdr-logo{display:flex;align-items:baseline;gap:8px}
.hdr-main{font-family:'DM Serif Display',serif;font-size:1.3rem}
.hdr-sub{font-size:.65rem;font-weight:500;opacity:.8;text-transform:uppercase;letter-spacing:.1em}
.hdr-badge{background:var(--r);padding:4px 10px;border-radius:20px;font-size:.7rem;font-weight:600}
#map{position:fixed;top:50px;left:0;right:0;bottom:0;z-index:1}
.fab{display:none;position:fixed;bottom:20px;right:20px;width:56px;height:56px;background:var(--r);color:#fff;border:none;border-radius:50%;font-size:1.4rem;cursor:pointer;z-index:1002;box-shadow:0 4px 12px rgba(0,0,0,.3);align-items:center;justify-content:center}
.panel{position:fixed;top:70px;left:20px;width:360px;background:#fff;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.12);z-index:1000;overflow:hidden;max-height:calc(100vh - 100px);display:flex;flex-direction:column}
.tabs{display:flex;background:var(--p);flex-shrink:0}
.tbtn{flex:1;padding:10px 4px;text-align:center;font-size:.65rem;font-weight:600;color:rgba(255,255,255,.6);cursor:pointer;border:none;background:none;transition:all .2s}
.tbtn.on{color:#fff;background:rgba(255,255,255,.15)}
.tbtn:hover{color:#fff}
.px{background:none;border:none;color:#fff;font-size:1.4rem;cursor:pointer;padding:0 12px;display:none}
.pane{display:none;overflow-y:auto;flex:1;padding:12px}
.pane.on{display:block}
.sec-ttl{font-family:'DM Serif Display',serif;font-size:.95rem;color:var(--p);margin-bottom:8px}
.rt-label{display:block;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:#888;margin-bottom:4px;margin-top:10px}
.rt-sel{width:100%;padding:8px 10px;border:1.5px solid var(--bd);border-radius:8px;font-size:.82rem;font-family:'DM Sans',sans-serif;background:#fff;color:var(--d)}
.rt-sel:focus{outline:none;border-color:var(--p)}
.rt-result{display:none;background:var(--l);border-radius:8px;padding:10px 12px;margin-top:10px}
.rt-result.on{display:block;animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.rt-main{font-size:.92rem;font-weight:700;color:var(--p);margin-bottom:4px}
.rt-detail{font-size:.78rem;color:#666;margin-bottom:4px}
.rt-tip{font-size:.74rem;color:#6b5a00;background:#fff8e6;border-left:3px solid var(--a);padding:5px 8px;margin-top:6px;border-radius:0 4px 4px 0}
.itin-card{background:var(--l);border-radius:10px;padding:12px;margin-bottom:8px;cursor:pointer;border:2px solid transparent;transition:all .2s}
.itin-card:hover{border-color:var(--p)}
.itin-card.on{border-color:var(--r);background:#fff}
.itin-card h3{font-family:'DM Serif Display',serif;font-size:.95rem;color:var(--p);margin-bottom:3px}
.imeta{font-size:.72rem;color:#666;margin-bottom:4px}
.idesc{font-size:.76rem;color:#555;line-height:1.4}
.dtabs{display:none;flex-wrap:wrap;gap:4px;margin-top:10px}
.dtabs.on{display:flex}
.dbtn{padding:5px 10px;border-radius:20px;font-size:.64rem;font-weight:600;border:1.5px solid var(--bd);background:#fff;color:var(--p);cursor:pointer;transition:all .15s}
.dbtn.on{background:var(--r);border-color:var(--r);color:#fff}
.bld-intro{font-size:.76rem;color:#666;margin-bottom:10px;padding:8px 10px;background:var(--l);border-radius:8px;line-height:1.5}
.bld-stops{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.bld-stop{display:flex;align-items:center;gap:6px;padding:8px 10px;background:#fff;border:1.5px solid var(--bd);border-radius:8px;transition:all .2s}
.bld-stop:hover{border-color:var(--p)}
.bld-handle{cursor:grab;color:#bbb;font-size:.95rem;flex-shrink:0}
.bld-num{width:20px;height:20px;border-radius:50%;background:var(--r);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;flex-shrink:0}
.bld-sel{flex:1;padding:6px 8px;border:1px solid #ddd;border-radius:6px;font-size:.78rem;background:#fff;font-family:'DM Sans',sans-serif}
.bld-sel:focus{outline:none;border-color:var(--p)}
.bld-rm{width:22px;height:22px;border:none;background:#f5f5f5;border-radius:50%;cursor:pointer;color:#999;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0}
.bld-rm:hover{background:#ffebee;color:var(--r)}
.bld-add{width:100%;padding:9px;border:2px dashed #ccc;background:transparent;border-radius:8px;cursor:pointer;font-size:.8rem;color:#666;transition:all .2s;font-family:'DM Sans',sans-serif;margin-bottom:8px}
.bld-add:hover{border-color:var(--p);color:var(--p)}
.bld-actions{display:flex;gap:8px;margin-bottom:4px}
.bld-calc{flex:1;padding:10px;background:var(--r);color:#fff;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-size:.82rem;font-family:'DM Sans',sans-serif;transition:opacity .2s}
.bld-calc:disabled{opacity:.45;cursor:not-allowed}
.bld-clear{padding:10px 14px;background:#f5f5f5;color:#666;border:none;border-radius:8px;cursor:pointer;font-size:.78rem;font-family:'DM Sans',sans-serif}
.bld-results{margin-top:10px}
.bld-leg{background:#fff;border:1px solid var(--bd);border-radius:8px;padding:10px 12px;margin-bottom:6px}
.bld-leg-head{font-weight:700;font-size:.82rem;color:var(--p);margin-bottom:3px}
.bld-leg-detail{font-size:.74rem;color:#555;line-height:1.5}
.bld-leg-tip{font-size:.69rem;color:#6b5a00;background:#fff8e6;border-left:2px solid var(--a);padding:4px 7px;margin-top:5px;border-radius:0 3px 3px 0}
.bld-stop.dragging{opacity:.5;border-style:dashed}
.bld-stop.drag-over{border-color:var(--r);background:#fff5f3}
.stops{position:fixed;bottom:20px;left:20px;width:360px;background:#fff;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.12);z-index:1000;display:none;overflow:hidden;max-height:44vh}
.stops.on{display:block;animation:up .25s ease}
@keyframes up{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
.stops-hd{background:var(--g);color:#fff;padding:11px 14px;display:flex;align-items:center;justify-content:space-between}
.stops-hd h3{font-family:'DM Serif Display',serif;font-size:.95rem;font-weight:400}
.sx{background:none;border:none;color:#fff;font-size:1.3rem;cursor:pointer;line-height:1}
.stops-bd{overflow-y:auto;max-height:calc(44vh - 46px)}
.srow{padding:11px 14px;border-bottom:1px solid #eee}
.srow:last-child{border-bottom:none}
.snum{display:inline-flex;align-items:center;justify-content:center;width:21px;height:21px;border-radius:50%;background:var(--r);color:#fff;font-size:.7rem;font-weight:700;margin-right:7px;vertical-align:middle;flex-shrink:0}
.sname{font-weight:600;font-size:.88rem;vertical-align:middle}
.stime{font-size:.7rem;color:var(--p);margin-left:6px;font-weight:600}
.stip{font-size:.73rem;color:#666;margin-top:3px;padding-left:28px}
.legend{position:fixed;bottom:20px;right:20px;background:#fff;padding:12px 15px;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.1);z-index:1000}
.legend h4{font-size:.66rem;font-weight:700;text-transform:uppercase;color:#888;margin-bottom:7px;letter-spacing:.04em}
.legr{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-size:.75rem;color:#555}
.legr:last-child{margin-bottom:0}
.legdot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.dtable{width:100%;border-collapse:collapse;font-size:.76rem;margin-top:6px}
.dtable th{background:var(--p);color:#fff;padding:5px 8px;text-align:left;font-size:.62rem;letter-spacing:.05em;text-transform:uppercase;font-weight:500}
.dtable td{padding:5px 8px;border-bottom:1px solid var(--bd);color:#555}
.dtable tr:last-child td{border-bottom:none}
.pu{padding:12px 14px;min-width:185px}
.pu-name{font-family:'DM Serif Display',serif;font-size:.98rem;color:var(--p);margin-bottom:2px}
.pu-type{font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;color:#999;margin-bottom:6px}
.pu-row{font-size:.74rem;color:#555;margin-bottom:3px;line-height:1.4}
.pu-row b{color:var(--d)}
.pu-tip{background:var(--l);border-radius:4px;padding:5px 7px;font-size:.7rem;color:#6b5a00;margin-top:5px}
.stop-lbl{margin-top:2px;font-size:10px;font-weight:600;color:#222;text-shadow:1px 1px 2px #fff,-1px -1px 2px #fff;white-space:nowrap;text-align:center}
@media(max-width:768px){
  .panel{position:fixed;top:auto;bottom:0;left:0;right:0;width:100%;border-radius:16px 16px 0 0;transform:translateY(100%);max-height:75vh;transition:transform .3s ease}
  .panel.open{transform:translateY(0)}
  .px{display:block}
  .stops{bottom:0;left:0;right:0;width:100%;border-radius:16px 16px 0 0;max-height:50vh}
  .legend{display:none}
  .fab{display:flex}
}
</style>
</head>
<body>
<header class="hdr">
  <div class="hdr-logo">
    <span class="hdr-main">France</span>
    <span class="hdr-sub">No-Stress Travel Guide</span>
  </div>
  <span class="hdr-badge">Interactive Map</span>
</header>
<div id="map"></div>
<button class="fab" id="fab">&#9776;</button>

<div class="panel" id="panel">
  <div class="tabs">
    <button class="tbtn on" onclick="showPane('itin',this)">&#128197; Itineraries</button>
    <button class="tbtn"    onclick="showPane('routes',this)">&#128674; Routes</button>
    <button class="tbtn"    onclick="showPane('byt',this)">&#128466; Build Your Trip</button>
    <button class="px" id="px">&#215;</button>
  </div>

  <div class="pane on" id="pane-itin"><div id="itinList"></div></div>

  <div class="pane" id="pane-routes">
    <div style="margin-bottom:16px">
      <div class="sec-ttl">TGV Journey Calculator</div>
      <p style="font-size:.74rem;color:#666;margin-bottom:10px;line-height:1.5">Select two cities to draw the route and see journey time, fare, and booking tip.</p>
      <label class="rt-label">From</label>
      <select class="rt-sel" id="selFrom"><option value="">Select origin...</option></select>
      <label class="rt-label">To</label>
      <select class="rt-sel" id="selTo"><option value="">Select destination...</option></select>
      <div class="rt-result" id="rtResult">
        <div class="rt-main" id="rtMain"></div>
        <div class="rt-detail" id="rtDetail"></div>
        <div class="rt-tip" id="rtTip"></div>
      </div>
    </div>
    <div>
      <div class="sec-ttl">Key journey times from Paris</div>
      <table class="dtable">
        <thead><tr><th>Destination</th><th>TGV time</th><th>Fare (advance)</th></tr></thead>
        <tbody>
          <tr><td>Lyon</td><td>2h</td><td>from €29</td></tr>
          <tr><td>Bordeaux</td><td>2h</td><td>from €29</td></tr>
          <tr><td>Marseille</td><td>3h 20min</td><td>from €35</td></tr>
          <tr><td>Nantes</td><td>2h 10min</td><td>from €29</td></tr>
          <tr><td>Strasbourg</td><td>1h 50min</td><td>from €25</td></tr>
          <tr><td>Toulouse</td><td>4h 20min</td><td>from €39</td></tr>
          <tr><td>Nice</td><td>5h 30min</td><td>from €49</td></tr>
          <tr><td>Tours (Loire)</td><td>1h 10min</td><td>from €19</td></tr>
          <tr><td>Avignon</td><td>2h 40min</td><td>from €35</td></tr>
          <tr><td>Rennes</td><td>1h 30min</td><td>from €25</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="pane" id="pane-byt">
    <div class="bld-intro">Build your custom France itinerary. Add cities in order, then calculate to see TGV times and tips for each leg.</div>
    <div class="bld-stops" id="bldStops">
      <div class="bld-stop" data-index="0">
        <span class="bld-handle">&#9776;</span>
        <span class="bld-num">1</span>
        <select class="bld-sel" data-index="0"><option value="">Add first stop...</option></select>
        <button class="bld-rm" data-index="0">&#215;</button>
      </div>
    </div>
    <button class="bld-add" id="bldAdd">+ Add Stop</button>
    <div class="bld-actions">
      <button class="bld-calc" id="bldCalc" disabled>Calculate Route</button>
      <button class="bld-clear" id="bldClear">Clear</button>
    </div>
    <div class="bld-results" id="bldResults"></div>
  </div>
</div>

<div class="stops" id="stops">
  <div class="stops-hd">
    <h3 id="stopsTitle">Itinerary</h3>
    <button class="sx" onclick="document.getElementById('stops').classList.remove('on')">&#215;</button>
  </div>
  <div class="stops-bd" id="stopsBd"></div>
</div>

<div class="legend">
  <h4>Legend</h4>
  <div class="legr"><div class="legdot" style="background:#1a3a5c"></div>Major city / TGV hub</div>
  <div class="legr"><div class="legdot" style="background:#2d6a4f"></div>Coastal / Riviera</div>
  <div class="legr"><div class="legdot" style="background:#8a5a10"></div>Historic region</div>
  <div class="legr"><div class="legdot" style="background:#6a2a2a"></div>Day-trip destination</div>
  <div class="legr" style="margin-top:6px"><div style="width:22px;height:0;border-top:3px dashed #2d6a4f"></div>Itinerary route</div>
  <div class="legr"><div style="width:22px;height:3px;background:#c4533a;border-radius:2px"></div>Active route</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
var nsMap, markersLayer, activeRouteObjs;
activeRouteObjs = [];

var DESTS = [
  {id:'paris',     n:'Paris',          lat:48.8566, lng:2.3522,  type:'hub',
   tag:'Capital and TGV hub for all regions', best:'May-June, Sept-Oct. Avoid August.',
   days:'3-5 days', eat:'Marais interior, Oberkampf, Canal Saint-Martin. Avoid Champs-Elysees and monument-facing restaurants.',
   tip:'Book Louvre and Eiffel Tower weeks ahead. Eiffel Tower summit: book exactly 60 days ahead. Museum Pass worth it for 3+ museums per day.'},
  {id:'lyon',      n:'Lyon',           lat:45.7640, lng:4.8357,  type:'hub',
   tag:'Gastronomic capital and southeast hub', best:'April-October.',
   days:'2-3 days', eat:'Bouchons in Vieux Lyon. Les Halles de Lyon Paul Bocuse for market browsing.',
   tip:'2h from Paris by TGV. Secondary hub for Provence, Alps, Burgundy. Vieux Lyon UNESCO historic district.'},
  {id:'marseille', n:'Marseille',      lat:43.2965, lng:5.3698,  type:'coastal',
   tag:'Mediterranean port and Provence gateway', best:'May-September.',
   days:'2 days', eat:'Cours Julien neighbourhood. Avoid port tourist restaurants for bouillabaisse - ask locals.',
   tip:'3h 20min from Paris. Gateway to Provence by car. MuCEM (11euros) excellent. Calanques half-day boat trip from Vieux-Port.'},
  {id:'nice',      n:'Nice',           lat:43.7102, lng:7.2620,  type:'coastal',
   tag:'Riviera base and Cote dAzur hub', best:'May-June, Sept-Oct. Avoid July-August peak.',
   days:'2-3 days', eat:'Vieux Nice interior streets. Cours Saleya market morning. Avoid Promenade des Anglais restaurants.',
   tip:'5h 30min from Paris by TGV or fly direct. Base for Monaco (20 min), Antibes (30 min), Cannes (40 min) by regional train.'},
  {id:'bordeaux',  n:'Bordeaux',       lat:44.8378, lng:-0.5792, type:'hub',
   tag:'Wine capital and Atlantic gateway', best:'September-October for harvest. May-June pleasant.',
   days:'2 days', eat:'Saint-Pierre neighbourhood. Rue Saint-Remi for wine bars.',
   tip:'2h from Paris. Gateway to Saint-Emilion (40 min train), Medoc (car needed), Dordogne. Wine tasting in Chartrons neighbourhood.'},
  {id:'toulouse',  n:'Toulouse',       lat:43.6047, lng:1.4442,  type:'hub',
   tag:'Pink city and Southwest gateway', best:'April-June, September-October.',
   days:'1-2 days', eat:'Capitole neighbourhood side streets. Carmes market area.',
   tip:'4h 20min from Paris. Gateway to Pyrenees and Carcassonne (50 min train). Airbus factory tours bookable in advance.'},
  {id:'strasbourg',n:'Strasbourg',     lat:48.5734, lng:7.7521,  type:'hub',
   tag:'Alsace capital and Christmas market city', best:'December for Christmas markets. May-September for Alsace villages.',
   days:'1-2 days', eat:'Petite France neighbourhood. Winstubs (Alsatian taverns) for choucroute garnie.',
   tip:'1h 50min from Paris. Base for Alsace wine route villages (car ideal). November-December Christmas markets are Europes best.'},
  {id:'nantes',    n:'Nantes',         lat:47.2184, lng:-1.5536, type:'hub',
   tag:'Loire gateway and Atlantic city', best:'May-September.',
   days:'1-2 days', eat:'Bouffay neighbourhood. Talensac market.',
   tip:'2h 10min from Paris. Gateway to Loire Valley chateaux and Brittany. Les Machines de lile: extraordinary mechanical elephant.'},
  {id:'avignon',   n:'Avignon',        lat:43.9493, lng:4.8055,  type:'historic',
   tag:'Papal city and Provence base', best:'April-June, Sept-Oct. Avoid July festival crowds.',
   days:'1-2 days', eat:'Rue des Teinturiers. Avoid main-square tourist menus.',
   tip:'2h 40min from Paris, 70 min from Lyon. Base for Luberon villages (car needed), Arles (20 min train), Pont du Gard (bus/car).'},
  {id:'tours',     n:'Tours',          lat:47.3941, lng:0.6848,  type:'historic',
   tag:'Loire Valley chateau gateway', best:'April-June, September.',
   days:'1-2 days base', eat:'Place Plumereau. Side streets off main square.',
   tip:'1h 10min from Paris Montparnasse. Best TGV base for Loire chateaux. Chenonceau 30 min, Chambord 45 min, Amboise 20 min. Car rental at station essential.'},
  {id:'bayeux',    n:'Bayeux',         lat:49.2764, lng:-0.7024, type:'historic',
   tag:'D-Day beaches and Norman tapestry', best:'May-September.',
   days:'1-2 days', eat:'Rue Saint-Martin. Simple Norman restaurants serving local cider and Camembert.',
   tip:'2h 20min from Paris (change Caen). Base for D-Day beaches by car or tour. Famous tapestry museum in town. Mont Saint-Michel 1h 30min by car.'},
  {id:'rennes',    n:'Rennes',         lat:48.1173, lng:-1.6778, type:'hub',
   tag:'Brittany gateway', best:'June-September.',
   days:'1 day en route', eat:'Place des Lices Saturday market. Rue Saint-Malo for crêperies.',
   tip:'1h 30min from Paris. Gateway to Brittany and Mont Saint-Michel (1h 30min by shuttle bus). Useful transit hub, not a primary destination.'},
  {id:'montsaintmichel', n:'Mont Saint-Michel', lat:48.6360, lng:-1.5115, type:'daytripicon',
   tag:'Iconic island abbey - day trip from Bayeux or Rennes', best:'May-June, September-October.',
   days:'Day trip only', eat:'Bring your own food or eat in Pontorson (mainland). Island restaurants are overpriced and mediocre.',
   tip:'Access by shuttle bus from parking area. Abbey entry 11euros. Book timed entry in advance. Arrive before 10:00 AM. Crowds peak 11-16:00. Stay on island overnight for magical empty-island experience.'},
  {id:'versailles', n:'Versailles',    lat:48.8049, lng:2.1204,  type:'daytripicon',
   tag:'Palace of Versailles - day trip from Paris', best:'Weekdays, avoid school holidays.',
   days:'Full day trip', eat:'Bring picnic for gardens. Town of Versailles has decent cafes.',
   tip:'45 min from Paris RER C (Versailles Rive Gauche). Closed Mondays. Book timed entry online. Arrive 09:00. Allow full day for palace plus Trianons and gardens. 19.50euros palace, 22euros full estate.'},
  {id:'arles',     n:'Arles',          lat:43.6769, lng:4.6278,  type:'historic',
   tag:'Van Gogh country and Roman amphitheatre', best:'April-June, September-October.',
   days:'1-2 days', eat:'Quartier des Arenes. Markets Saturday morning at Boulevard des Lices.',
   tip:'20 min from Avignon by train. Roman amphitheatre still in use for bullfights. Van Gogh trail through the town. Camargue wetlands 30 min south by car.'},
  {id:'aix',       n:'Aix-en-Provence',lat:43.5297, lng:5.4474,  type:'historic',
   tag:'Cezanne country and Provencal elegance', best:'April-June, September-October.',
   days:'1-2 days', eat:'Quartier Mazarin. Morning market on Place Richelme.',
   tip:'30 min from Marseille by TGV or bus. Cours Mirabeau is the main boulevard. Cezanne atelier 6euros. Sainte-Victoire mountain visible from town - hike or drive up.'},
  {id:'cannes',    n:'Cannes',         lat:43.5528, lng:7.0174,  type:'coastal',
   tag:'Film Festival city and Riviera beach town', best:'September-October or May outside festival.',
   days:'1 day from Nice', eat:'Interior streets of old town Le Suquet. Avoid Croisette promenade restaurants.',
   tip:'40 min from Nice by regional train. Outside Film Festival (mid-May), pleasant beach town. Marche Forville for market picnics. Lerins islands accessible by ferry - quieter beaches.'},
  {id:'dijon',     n:'Dijon',          lat:47.3220, lng:5.0415,  type:'historic',
   tag:'Burgundy capital and wine gateway', best:'September-October for harvest.',
   days:'1-2 days', eat:'Rue Amiral Roussin. Local mustard and wine shops.',
   tip:'1h 35min from Paris. Gateway to Cote dOr wine villages by car. Les Halles Dijon covered market. 90 min from Lyon by TGV or car.'}
];

var ROUTES = {
  'paris-lyon':         {t:'2h',        d:'465 km', m:'TGV (every 30-60 min)', tip:'From €29 booked ahead, €120+ last-minute. Most frequent TGV route in France. Departs Gare de Lyon.'},
