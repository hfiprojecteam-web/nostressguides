  'lyon-dijon':         {t:'1h 35min',  d:'195 km', m:'TGV or regional', tip:'Wine corridor. Dijon-Lyon by TGV 1h 35min. By car: 1h 30min, allows stops in Cote dOr villages.'},
  'bordeaux-toulouse':  {t:'2h 10min',  d:'245 km', m:'TGV or Intercites', tip:'From €19 advance. Southwest corridor. No TGV high-speed for all of route - some sections regional.'},
  'marseille-nice':     {t:'2h 30min',  d:'200 km', m:'TGV or regional', tip:'Regional trains run along coast, more scenic but slower. TGV faster but misses coastal views.'},
  'marseille-avignon':  {t:'35 min',    d:'100 km', m:'TGV (frequent)', tip:'Fast and cheap corridor. Marseille-Avignon-Lyon the main Provence-north axis.'},
  'nice-cannes':        {t:'40 min',    d:'33 km',  m:'TER regional (every 30 min)', tip:'€6-8 regional train runs along the coast. No TGV needed. Villefranche, Antibes, Juan-les-Pins all on this line.'},
  'avignon-arles':      {t:'20 min',    d:'37 km',  m:'TER regional (hourly)', tip:'€5-7. Short regional hop. Or bus. Drive: 35 min. Arles is the best day trip from Avignon.'},
  'avignon-aix':        {t:'1h',        d:'85 km',  m:'TGV or bus', tip:'Train less direct. Bus from Avignon to Aix-en-Provence TGV station: 1h 15min, reliable, cheap.'},
  'tours-bayeux':       {t:'3h',        d:'330 km', m:'TGV via Paris or Caen', tip:'No direct train. Best route: Tours to Paris (1h 10min), Paris to Caen (2h), Caen to Bayeux (20 min). Or: drive 3h direct.'},
  'rennes-montsaintmichel':{t:'1h 30min',d:'70 km', m:'Bus + shuttle', tip:'No direct train. Coach from Rennes bus station (1h 15min) then shuttle to island. Or drive 1h 30min. Book shuttle bus ahead in summer.'},
  'bordeaux-aix':       {t:'4h',        d:'480 km', m:'TGV via Marseille', tip:'Bordeaux to Marseille (3h 30min), Marseille to Aix 30min by bus/train. No direct southwest-southeast TGV.'},
  'nantes-tours':       {t:'1h 25min',  d:'130 km', m:'TER regional', tip:'Loire corridor connection. Regional train - no TGV needed. Connects Atlantic (Nantes) to Loire chateaux (Tours).'}
};

